<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.SonicPlayer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.SonicPlayer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F0F1A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.SonicPlayer</item>
        <item name="android:statusBarColor">#0F0F1A</item>
        <item name="android:navigationBarColor">#0F0F1A</item>
    </style>
</resources>
